DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<your-databricks-token>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
# completely optional if agent will have direct access to the warehouse and catalogue, dummy tables
DATABRICKS_CATALOG=fmcg_demo
DATABRICKS_SCHEMA=analytics
DELTA_BASE_PATH=data/delta
# agent config
DEFAULT_BRAND=Brand A
TOP_N_OPPORTUNITIES=10